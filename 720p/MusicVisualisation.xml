<?xml version="1.0" encoding="UTF-8"?>
<window>
	<onload condition="System.HasAddon(script.artistslideshow) + Skin.HasSetting(VisBgArtistSlideshow)">RunScript(script.artistslideshow)</onload>
	<onload>RunPlugin(plugin://script.skinvariables/?info=get_jsonrpc&amp;method=Settings.GetSettingValue&amp;setting=musiclibrary.artistsfolder&amp;window_prop=Musiclibrary.artistsfolder&amp;window_id=Home)</onload>
	<defaultcontrol></defaultcontrol>
	<controls>
		<control type="image">
			<include>MusicVis_Background</include>
			<texture background="true" fallback="home_art/music.jpg">$INFO[Player.Art(fanart)]</texture>
			<visible>Skin.HasSetting(VisBgFanart) | [Skin.HasSetting(VisBgExtraFanart) + String.IsEmpty(Control.GetLabel(6999)) + String.IsEmpty(Control.GetLabel(6951))]</visible>
		</control>
		<control type="group">
			<description>Extra Fanart from fanart, fanart1, fanart2, ...</description>
			<visible>Skin.HasSetting(VisBgExtraFanart) + [!Skin.HasSetting(VisBgPreferExtrafanartDirectory) | [Skin.HasSetting(VisBgPreferExtrafanartDirectory) + String.IsEmpty(Control.GetLabel(6999))]]</visible>
			<control type="fadelabel" id="6951">
				<left>-100</left>
				<top>-100</top>
				<font>METF_MediaDetailsSmall</font>
				<scrollspeed>200</scrollspeed>
				<randomize>true</randomize>
				<include>MusicPlayerExtraFanartItems</include>
		 	</control>
		 	<control type="multiimage" id="6950">
				<include>MusicVis_Background</include>
				<timeperimage>6000</timeperimage>
				<fadetime>1500</fadetime>
				<imagepath background="true" diffuse="FanartDiffuse.png">$INFO[Control.GetLabel(6951)]</imagepath>
			</control>
		</control>
		<control type="group">
			<description>Extra Fanart from extrafanart directory</description>
			<visible>Skin.HasSetting(VisBgExtraFanart) + Skin.HasSetting(VisBgPreferExtrafanartDirectory)</visible>
			<control type="multiimage" id="6999">
				<include>MusicVis_Background</include>
				<timeperimage>6000</timeperimage>
				<fadetime>1500</fadetime>
				<imagepath background="true" diffuse="FanartDiffuse.png">$INFO[Window(Home).Property(Musiclibrary.artistsfolder.Value)]$INFO[MusicPlayer.Artist]/extrafanart</imagepath>
			</control>
		</control>
		<control type="image">
			<include>MusicVis_Background</include>
			<texture background="true">$INFO[Window(Visualisation).Property(ArtistSlideshow.Image)]</texture>
			<visible>Skin.HasSetting(VisBgArtistSlideshow) + !String.IsEmpty(Window(Visualisation).Property(ArtistSlideshow.Image))</visible>
		</control>
		<control type="visualisation" id="2">
			<description>visualisation</description>
			<posx>0</posx>
			<posy>0</posy>
			<width>1280</width>
			<height>720</height>
			<include>Animation_BackdropFade</include>
		</control>
		<control type="group">
			<visible>Player.ShowInfo + ![Window.IsVisible(musicosd) | Window.IsVisible(seekbar)]</visible>
			<include condition="!Skin.HasSetting(SlimMusicInfo)">OSD_Banner</include>
			<include condition="!Skin.HasSetting(SlimMusicInfo)">OSD_Deck_Full</include>
			<include condition="!Skin.HasSetting(SlimMusicInfo)">OSD_Music_MediaOverlay</include>
			<include condition="Skin.HasSetting(SlimMusicInfo)">OSD_Deck_Slim</include>
		</control>
	</controls>
</window>
