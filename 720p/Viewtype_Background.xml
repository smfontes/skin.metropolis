			</control>
			<control type="group">
				<description>Info Details</description>
				<width>390</width>
				<left>10</left>
				<control type="label">
					<description>Genre on top line</description>
					<label>$INFO[ListItem.Genre]</label>
					<top>3</top>
					<height>27</height>
					<align>center</align>
					<scroll>true</scroll>
					<font>METF_DialogMediumBold</font>
					<textcolor>MediaDetailsGenre</textcolor>
					<visible>!String.IsEmpty(ListItem.Genre)</visible>
				</control>
				<control type="group">
					<description>Second line</description>
					<top>23</top>
					<height>30</height>
					<!-- Left hand side -->
					<control type="label">
						<description>Year</description>
						<align>left</align>
						<font>METF_MediaDetailsSmall</font>
						<textcolor>MediaDetailsYear</textcolor>
						<label>$INFO[ListItem.Year]</label>
						<visible>!String.IsEmpty(ListItem.Year) + !Container.Content(episodes) + !Container.Content(artists)</visible>
					</control>
					<control type="label">
						<description>First Aired for episodes</description>
						<align>left</align>
						<font>METF_MediaDetailsSmall</font>
						<textcolor>MediaDetailsYear</textcolor>
						<label>$INFO[ListItem.Premiered]</label>
						<visible>!String.IsEmpty(ListItem.Premiered) + Container.Content(episodes)</visible>
					</control>
					<control type="label">
						<description>Date for artists</description>
						<align>left</align>
						<font>METF_MediaDetailsSmall</font>
						<textcolor>MediaDetailsYear</textcolor>
						<label>$INFO[ListItem.Property(Artist_Born)]</label>
						<visible>!String.IsEmpty(ListItem.Property(Artist_Born)) + Container.Content(artists)</visible>
					</control>
					<control type="label">
						<description>Picture Date / time</description>
						<align>left</align>
						<font>METF_MediaDetailsSmall</font>
						<textcolor>MediaDetailsYear</textcolor>
						<label>$INFO[ListItem.PictureLongDateTime]</label>
						<visible>!String.IsEmpty(ListItem.PictureLongDateTime)</visible>
					</control>
					<!-- Right hand side -->
					<control type="label">
						<description>Duration hh:mm:ss</description>
						<align>right</align>
						<font>METF_MediaDetailsSmall</font>
						<textcolor>MediaDetailsDuration</textcolor>
						<label>$INFO[ListItem.Duration(hh:mm:ss)]</label>
						<visible>!String.IsEmpty(ListItem.Duration)</visible>
						<visible>!String.IsEqual(ListItem.DBtype,song) | [String.IsEqual(ListItem.DBtype,song) + !String.IsEqual(ListItem.Duration(hh),00)]</visible>
